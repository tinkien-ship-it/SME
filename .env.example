# Copy to .env and fill in secrets. Do not commit real credentials.

SECRET_KEY=change_me

# Database backend: sqlite (default) | postgres
SME_DB_BACKEND=sqlite

# Prefer SME_PG_URL for Postgres. Avoid pointing DATABASE_URL at sqlite:/// when using PG.
# SME_PG_URL=postgresql://sme:SECRET@127.0.0.1:5432/sme
# SME_PG_POOL_MIN=2
# SME_PG_POOL_MAX=30
# SME_PG_REGISTRY_SCHEMA=public

# SQLAlchemy-style URL used by some tools (optional; keep sqlite for local unless cutover)
DATABASE_URL=sqlite:///pos.db

# Public site
# PUBLIC_BASE_URL=https://ketoshop.pro.vn
# SME_CANONICAL_HOST=ketoshop.pro.vn
# SME_SESSION_COOKIE_DOMAIN=.ketoshop.pro.vn
