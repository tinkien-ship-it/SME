# Copy to .env and fill in secrets. Do not commit real credentials.

SECRET_KEY=change_me

# ── Database ──────────────────────────────────────────────────────────
# sqlite = dev/local | postgres = production (VPS nhiều user)
SME_DB_BACKEND=postgres
SME_PG_URL=postgresql://sme:SECRET@127.0.0.1:5432/sme
SME_PG_POOL_MIN=4
SME_PG_POOL_MAX=24
SME_REQUIRE_POSTGRES=1
SME_SKIP_RUNTIME_MIGRATE=1
SME_PG_REGISTRY_SCHEMA=public

# Không để DATABASE_URL=sqlite khi đã cutover Postgres (gây nhầm backend)
# DATABASE_URL=postgresql://sme:SECRET@127.0.0.1:5432/sme

# SQLite tuning (chỉ dev / trước cutover)
# SME_DB_BACKEND=sqlite
# DATABASE_URL=sqlite:///pos.db

# ── Gunicorn (production VPS) ─────────────────────────────────────────
# ExecStart: gunicorn -c gunicorn.conf.py app:app
# GUNICORN_BIND=127.0.0.1:8000
# Postgres (mặc định trong gunicorn.conf khi SME_DB_BACKEND=postgres):
#   workers=4–12 sync, GUNICORN_PRELOAD=1, GUNICORN_MAX_REQUESTS=3000
# GUNICORN_TIMEOUT=120

# ── Public site ───────────────────────────────────────────────────────
# PUBLIC_BASE_URL=https://ketoshop.pro.vn
# SME_CANONICAL_HOST=ketoshop.pro.vn
# SME_SESSION_COOKIE_DOMAIN=.ketoshop.pro.vn

# ── ESS (Cổng nhân viên) ──────────────────────────────────────────────
# User cần permission "ess_portal" (Settings → Users) + HR gán:
#   POST /api/hrm/ess/link  { employee_id, user_id, ess_enabled: true }
# Hoặc chạy: UPDATE employees SET user_id=?, ess_enabled=1 WHERE id=?
